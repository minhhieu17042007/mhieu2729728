   "source": [
    "def lon_nhat(n) : \n",
    "    x = 0 \n",
    "    for i in range(0,len(n)) : \n",
    "        if n[i] == max(n) : \n",
    "            x = i \n",
    "    return x \n",
    "n = list(map(int,input().split()))\n",
    "print(lon_nhat(n))"
   ]
  }
